{
  "name": "translateio-monorepo",
  "private": true,
  "scripts": {
    "build:backend": "pnpm --filter ./apps/backend-package/ build",
    "test": "pnpm --filter ./testing/ test",
    "dev:backend": "pnpm --filter ./apps/backend-package/ watch",
    "clean": "pnpm --recursive run clean",
    "build:electron:app:win": "pnpm -F ./apps/electron/backend build:win",
    "build:electron:app:mac": "pnpm -F ./apps/electron/backend build:mac",
    "build:electron:app:linux": "pnpm -F ./apps/electron/backend build:linux"
  },
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
